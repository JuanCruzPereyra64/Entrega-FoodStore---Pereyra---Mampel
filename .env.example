# Variables de entorno requeridas
# Copiar este archivo como .env y completar los valores

# ── Base de Datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/food_store

# ── Seguridad JWT ──────────────────────────────────────────────────────────────
SECRET_KEY=tu-clave-secreta-muy-larga-minimo-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── MercadoPago (obtener en https://www.mercadopago.com.ar/developers) ─────────
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxx
MP_NOTIFICATION_URL=https://tu-dominio.com/api/v1/pagos/webhook

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxx
